<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mapsui="using:Mapsui.UI.Avalonia"
        xmlns:vm="using:AprsLive.App.ViewModels"
        xmlns:local="using:AprsLive.App.Views"
        xmlns:conv="using:Avalonia.Data.Converters"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="AprsLive.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="APRS_Live"
        Width="1000" Height="650"
        WindowState="Maximized">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
    <TabControl>
        <TabItem Header="Carte">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="8">
                    <!-- Fixed-width centre: Best DX stays centred and the right-hand group always starts at the same x. -->
                    <Grid ColumnDefinitions="*,290,*">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Carte en ligne" Command="{Binding UseOnlineMapCommand}" />
                            <Button Content="Carte hors-ligne..." Click="OnBrowseMbTilesClick"
                                    ToolTip.Tip="Charger une carte MBTiles hors-ligne" />
                            <Button Content="Messages" Command="{Binding Messages.TogglePanelCommand}" />
                            <Button Content="Envoyer position" Command="{Binding Station.SendNowCommand}"
                                    ToolTip.Tip="Envoyer la balise de position maintenant (liaisons en émission)" />
                            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="IndianRed" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Station.BestDxDisplay}" ToolTip.Tip="{Binding Station.BestDxTip}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <local:AudioMeterView DataContext="{Binding LinkA}" />
                            <local:AudioMeterView DataContext="{Binding LinkB}" />
                            <Border Background="#FF1E1E1E" CornerRadius="4" Padding="6,4" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding AprsIs.StateTip}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="APRS-IS" FontSize="9" Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                                    <Ellipse Width="10" Height="10" Fill="{Binding AprsIs.StateBrush}" />
                                    <Panel Width="10" Height="10" ToolTip.Tip="Paquet reçu du serveur">
                                        <Ellipse Width="10" Height="10" Fill="#FF555555" IsVisible="{Binding !AprsIs.RxActive}" />
                                        <Ellipse Width="10" Height="10" Fill="#FF4AA3FF" IsVisible="{Binding AprsIs.RxActive}" />
                                    </Panel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Right" Width="320" IsVisible="{Binding Messages.IsPanelOpen}"
                        BorderBrush="Gray" BorderThickness="1,0,0,0">
                    <local:MessagesPanelView DataContext="{Binding Messages}" />
                </Border>

                <!-- UI-View32-style status line: last frame heard, its port and the raw frame. -->
                <Border DockPanel.Dock="Bottom" Padding="8,3" BorderBrush="Gray" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Dernière :" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LastHeardDisplay}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding LastHeardFrame}" ToolTip.Tip="{Binding LastHeardFrame}"
                                   FontFamily="monospace" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Panel>
                    <mapsui:MapControl Name="Map" Map="{Binding MapController.Map}" />

                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Spacing="4">
                        <Button Content="+" Width="36" Height="36" FontSize="18" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom avant" />
                        <Button Content="−" Width="36" Height="36" FontSize="18" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom arrière" />
                    </StackPanel>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="6,2"
                            Background="#A0808080" CornerRadius="4">
                        <TextBlock Text="{Binding ZoomLevel, StringFormat='Zoom {0}'}" FontSize="11" Foreground="White" />
                    </Border>

                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" Padding="10,4"
                            Background="#D0303030" CornerRadius="4"
                            IsVisible="{Binding Station.Toast, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Station.Toast}" Foreground="White" />
                    </Border>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10" MaxWidth="300"
                            Background="#FFFFF3CD" BorderBrush="#FFE0A800" BorderThickness="1" CornerRadius="4"
                            IsVisible="{Binding Messages.Notification, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Messages.Notification}" TextWrapping="Wrap" Foreground="Black" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Ouvrir" Command="{Binding Messages.OpenNotificationCommand}" />
                                <Button Content="✕" Command="{Binding Messages.DismissNotificationCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Popup Name="StationPopup" PlacementTarget="Map" Placement="Pointer" IsLightDismissEnabled="True">
                        <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                                Padding="10" MaxWidth="280" BoxShadow="0 2 8 0 #40000000">
                            <StackPanel Spacing="4" Name="StationPopupContent" />
                        </Border>
                    </Popup>
                </Panel>
            </DockPanel>
        </TabItem>

        <TabItem Header="Stations">
            <local:StationsView DataContext="{Binding Stations}" />
        </TabItem>

        <TabItem Header="Couverture">
            <local:CoverageView DataContext="{Binding Coverage}" />
        </TabItem>

        <TabItem Header="Paramètres">
            <local:SettingsView />
        </TabItem>
    </TabControl>

    <!-- Fixed colours on purpose: a self-contained card readable in both themes. -->
    <Border IsVisible="{Binding ShowStartupConnectErrors}" HorizontalAlignment="Center" VerticalAlignment="Center"
            MaxWidth="520" Padding="16" CornerRadius="6" Background="White"
            BorderBrush="IndianRed" BorderThickness="2" BoxShadow="0 4 16 0 #60000000">
        <StackPanel Spacing="10">
            <TextBlock Text="Reconnexion impossible au démarrage" FontWeight="Bold" FontSize="15" Foreground="Black" />
            <ItemsControl ItemsSource="{Binding StartupConnectErrors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="Black" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Vérifiez que le TNC est branché et allumé. Une liaison KISS réessaie seule (après 10 s, 30 s, 1 min puis toutes les 2 min) et disparaît de cette liste une fois reconnectée ; « Réessayer » tente tout de suite, « Déconnecter » (Paramètres → Radio) arrête les essais."
                       TextWrapping="Wrap" FontSize="11" Foreground="#FF555555" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Réessayer" Command="{Binding RetryStartupConnectionsCommand}" />
                <Button Content="Fermer" Command="{Binding DismissStartupConnectErrorsCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
    </Panel>
</Window>
