<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AprsLive.App.ViewModels"
             xmlns:icons="using:AprsLive.App.Icons"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="600"
             x:Class="AprsLive.App.Views.ObjectsView"
             x:DataType="vm:ObjectsViewModel">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12" MaxWidth="500" HorizontalAlignment="Left">
            <TextBlock Text="Objets" FontSize="18" FontWeight="Bold" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="Trames objet APRS : signalent un événement, un relais, un point fixe... sous un nom propre, indépendamment de l'indicatif de la station." />
            <Button Content="Ajouter un objet" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Items}" MaxWidth="500" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ObjectItemViewModel">
                        <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Nom (9 caractères max)" />
                                        <TextBox Text="{Binding Name}" MaxLength="9" Watermark="EVENT1" Width="160" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Supprimer" Command="{Binding DeleteCommand}" VerticalAlignment="Bottom" />
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Coordonnées GPS" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <TextBox Text="{Binding LatitudeText}" Watermark="Latitude" />
                                        <TextBox Grid.Column="1" Text="{Binding LongitudeText}" Watermark="Longitude" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Icône" />
                                    <ComboBox ItemsSource="{Binding AvailableSymbols}"
                                              SelectedItem="{Binding SelectedSymbol}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="icons:SymbolChoice">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Image Source="{Binding Icon}" Width="20" Height="20" />
                                                    <TextBlock Text="{Binding Entry.Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Commentaire" />
                                    <TextBox Text="{Binding Comment}" Watermark="Détails de l'événement..." />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Intervalle d'envoi (minutes, 0 = manuel uniquement)" />
                                    <NumericUpDown Value="{Binding IntervalMinutes}" Minimum="0" Maximum="1440" Increment="1"
                                                   Width="140" HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Enregistrer" Command="{Binding SaveCommand}" />
                                    <Button Content="Envoyer maintenant" Command="{Binding SendNowCommand}" />
                                    <Button Content="Tuer (retirer)" Command="{Binding KillCommand}" />
                                    <TextBlock Text="{Binding LiveStateText, StringFormat='État : {0}'}" VerticalAlignment="Center" Opacity="0.7" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
