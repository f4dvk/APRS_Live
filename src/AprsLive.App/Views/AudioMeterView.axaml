<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AprsLive.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="180" d:DesignHeight="36"
             x:Class="AprsLive.App.Views.AudioMeterView"
             x:DataType="vm:LinkViewModel">

    <Border IsVisible="{Binding ShowMeter}" Background="#FF1E1E1E" CornerRadius="4" Padding="6,4">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding IsReconnecting}"
                        ToolTip.Tip="{Binding ReconnectTip}">
                <TextBlock Text="{Binding CarrierLabel}" FontSize="9" Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                <Ellipse Width="10" Height="10" Fill="#FFFF9500" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding !IsReconnecting}"
                        ToolTip.Tip="S'allume quand une trame est détectée (DCD, modem audio) ou que le TNC active sa ligne CD série — pas sur un simple fanion isolé">
                <TextBlock Text="{Binding CarrierLabel}" FontSize="9" Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                <Panel Width="10" Height="10">
                    <Ellipse Width="10" Height="10" Fill="#FF555555" IsVisible="{Binding !CarrierActive}" />
                    <Ellipse Width="10" Height="10" Fill="#FF2ECC40" IsVisible="{Binding CarrierActive}" />
                </Panel>
            </StackPanel>

            <Canvas Width="{Binding SpectrumTotalWidth}" Height="{Binding SpectrumBarMaxHeight}"
                    IsVisible="{Binding ShowSpectrum}"
                    ToolTip.Tip="Spectre audio — repères bleu (1200 Hz, mark) et orange (2200 Hz, space)">
                <ItemsControl ItemsSource="{Binding SpectrumBars}" Canvas.Left="0" Canvas.Top="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Bottom" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:Double">
                            <Rectangle Width="4" Fill="#FF2ECC40" Height="{Binding}" VerticalAlignment="Bottom" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Width="1" Fill="#FF4AA3FF" Opacity="0.8"
                           Height="{Binding SpectrumBarMaxHeight}" Canvas.Left="{Binding MarkMarkerX}" Canvas.Top="0" />
                <Rectangle Width="1" Fill="#FFFF9500" Opacity="0.8"
                           Height="{Binding SpectrumBarMaxHeight}" Canvas.Left="{Binding SpaceMarkerX}" Canvas.Top="0" />
            </Canvas>
        </StackPanel>
    </Border>
</UserControl>
