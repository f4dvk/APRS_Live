<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AprsLive.App.App"
             xmlns:local="using:AprsLive.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant; ThemeService
                  overrides this at runtime once settings are loaded. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>